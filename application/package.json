    "validate": "node scripts/validate.ts",
    "ci": "npm run check && npm test && npm run validate && npm run build"
  },
  "dependencies": {
    "astro": "7.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/compiler-rs": "0.5.2",
    "@types/node": "22.20.5",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
