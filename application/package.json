{
  "name": "cutups",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host --ignore-lock",
    "build": "astro build",
    "check": "astro check && oxlint src scripts && oxfmt --check",
    "fmt": "oxfmt",
    "test": "vitest run",
    "validate": "node scripts/validate.ts",
    "ci": "npm run check && npm test && npm run validate && npm run build"
  },
  "dependencies": {
    "astro": "7.4.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/compiler-rs": "0.5.2",
    "@types/node": "22.20.5",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
