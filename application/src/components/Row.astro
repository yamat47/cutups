---
// A shelf: one heading and its plays side by side, scrolled sideways. The next card
// shows at the edge so that the row reads as more than one screen wide.
import type { Play } from "../lib/catalog.ts";
import type { Kind } from "../content/schema.ts";
import { KIND_LABEL } from "../lib/labels.ts";
import PlayCard from "./PlayCard.astro";

interface Props {
  heading: string;
  plays: Play[];
  /** The tag the shelf is for; its heading links to the tag's page. */
  kind?: Kind | undefined;
  href?: string | undefined;
}

const { heading, plays, kind, href } = Astro.props;
---

<section class="row" data-kind={kind}>
  <header>
    <h2>
      {kind && <span class="kind">{KIND_LABEL[kind]}</span>}
      <span class="name">{heading}</span>
    </h2>
    {href && <a href={href}>{plays.length === 1 ? "1 play" : `${plays.length} plays`}</a>}
  </header>
  <div class="shelf">
    {plays.map((play) => (
      <PlayCard play={play} />
    ))}
  </div>
</section>

<style>
  .row {
    margin-top: 2rem;
  }
  header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
  }
  h2 {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0;
    font-size: 1.375rem;
    font-weight: 700;
  }
  .kind {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--kind);
  }
  header a {
    flex: none;
    font-size: 0.75rem;
    color: var(--color-muted);
    text-decoration: none;
  }
  .shelf {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(62vw, 15rem);
    gap: 0.75rem;
    margin: 0.75rem calc(-1 * var(--gutter)) 0;
    padding: 0 var(--gutter);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }
  .shelf::-webkit-scrollbar {
    display: none;
  }
  .shelf > :global(*) {
    scroll-snap-align: start;
  }
</style>
