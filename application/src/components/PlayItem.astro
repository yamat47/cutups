---
// One play in a feed: its name, its game, the video itself and its tags, so that a list
// can be watched without opening each play.
import type { Catalog, Play } from "../lib/catalog.ts";
import { playHref } from "../lib/hrefs.ts";
import { gameLabel } from "../lib/labels.ts";
import { partsOf, type PartRef } from "../lib/relations.ts";
import Chip from "./Chip.astro";
import Embed from "./Embed.astro";

interface Props {
  play: Play;
  catalog: Catalog;
  /** The tag the feed is filtered by, drawn filled on the play's row. */
  current?: PartRef | undefined;
}

const { play, catalog, current } = Astro.props;
const { data } = play;
const isCurrent = (ref: PartRef) => ref.kind === current?.kind && ref.slug === current?.slug;
---

<article>
  <h2 class="name">
    <a href={playHref(play.slug)}>{data.title}</a>
  </h2>
  <p class="muted">{gameLabel(data.game)}</p>
  <Embed url={data.video.url} title={data.title} />
  <div class="rail">
    {partsOf(data).map((ref) => (
      <Chip part={catalog.part(ref)} current={isCurrent(ref)} />
    ))}
  </div>
</article>

<style>
  article {
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--color-border);
  }
  h2 {
    margin: 0;
    font-size: 1.625rem;
  }
  h2 a {
    text-decoration: none;
  }
  .muted {
    margin: var(--space-1) 0 var(--space-3);
  }
  .rail {
    margin-top: var(--space-3);
  }
</style>
