---
// A part as a tag: a link to every play that shares it, marked with its kind's color.
import type { Part } from "../lib/catalog.ts";
import { partHref } from "../lib/hrefs.ts";
import { KIND_LABEL } from "../lib/labels.ts";

interface Props {
  part: Part;
}

const { part } = Astro.props;
---

<a
  class="chip"
  data-kind={part.kind}
  href={partHref(part)}
  aria-label={`${KIND_LABEL[part.kind]}: ${part.data.title}`}
>
  {part.data.title}
</a>

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    height: 1.75rem;
    padding: 0 0.625rem;
    border-radius: 999px;
    background: var(--color-surface);
    font-size: 0.8125rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .chip::before {
    content: "";
    width: 0.4375rem;
    height: 0.4375rem;
    border-radius: 50%;
    background: var(--kind);
  }
</style>
