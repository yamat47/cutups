---
// One play in a list: its name, its game, its parts and the defense it met.
import type { Catalog, Play } from "../lib/catalog.ts";
import { gameLabel } from "../lib/labels.ts";
import { playHref } from "../lib/hrefs.ts";
import { partsOf, vsOf } from "../lib/relations.ts";
import Chip from "./Chip.astro";

interface Props {
  play: Play;
  catalog: Catalog;
  /** The heading level of the play's name, which depends on the page around the card. */
  level?: 2 | 3 | 4;
}

const { play, catalog, level = 2 } = Astro.props;
const { data } = play;
const Heading = `h${level}` as const;
---

<article>
  <Heading class="name">
    <a href={playHref(play.slug)}>{data.title}</a>
  </Heading>
  <ul class="meta">
    <li>{data.title_ja}</li>
    <li>{gameLabel(data.game)}</li>
  </ul>
  <div class="rail">
    {partsOf(data).map((ref) => (
      <Chip part={catalog.part(ref)} />
    ))}
    <Chip part={catalog.part(vsOf(data))} />
  </div>
</article>

<style>
  article {
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--color-border);
  }
  .name {
    margin: 0;
    font-size: 1.625rem;
    line-height: 1.1;
  }
  .name a {
    color: var(--color-fg);
    text-decoration: none;
  }
  .rail {
    margin-top: var(--space-2);
  }
</style>
