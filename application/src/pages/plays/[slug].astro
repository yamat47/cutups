---
import { render } from "astro:content";
import Chip from "../../components/Chip.astro";
import Embed from "../../components/Embed.astro";
import PlayList from "../../components/PlayList.astro";
import Base from "../../layouts/Base.astro";
import { loadCatalog, type Catalog, type Play } from "../../lib/catalog.ts";
import { playHref } from "../../lib/hrefs.ts";
import { CONFIDENCE_LABEL, KIND_LABEL, gameLabel } from "../../lib/labels.ts";
import { buildsOnThis, partsOf, samePicture, sameScheme, vsOf } from "../../lib/relations.ts";

export async function getStaticPaths() {
  const catalog = await loadCatalog();
  return catalog.plays.map((play) => ({ params: { slug: play.slug }, props: { play, catalog } }));
}

interface Props {
  play: Play;
  catalog: Catalog;
}

const { play, catalog } = Astro.props;
const { data } = play;
const { Content } = await render(play.entry);

const picture = samePicture(catalog.plays, play);
const schemes = sameScheme(catalog.plays, catalog.parts, play);
const answers = buildsOnThis(catalog.plays, play);
const buildsOn = data.builds_on ? catalog.play(data.builds_on) : undefined;
const hasRelations = picture.length + schemes.length + answers.length > 0;
---

<Base title={data.title}>
  <h1 class="name">{data.title}</h1>
  <ul class="meta">
    <li>{data.title_ja}</li>
    <li>{gameLabel(data.game)}</li>
    <li>
      <a href={data.video.url}>@{data.video.author}</a>
    </li>
  </ul>

  <Embed url={data.video.url} />

  <div class="rail" aria-label="パーツと守備">
    {partsOf(data).map((ref) => (
      <Chip part={catalog.part(ref)} labeled />
    ))}
    <Chip
      part={catalog.part(vsOf(data))}
      labeled
      note={[CONFIDENCE_LABEL[data.vs.confidence], data.vs.front].filter(Boolean).join(" ")}
    />
  </div>

  {data.builds_on && (
    <p class="muted">
      踏まえたプレー:{" "}
      {buildsOn ? (
        <a href={playHref(buildsOn.slug)}>{buildsOn.data.title}</a>
      ) : (
        <span>{data.builds_on}（未登録）</span>
      )}
    </p>
  )}

  <div class="body">
    <Content />
  </div>

  {hasRelations && (
    <section class="related">
      <h2>つながり</h2>
      <PlayList heading="同じ絵から別のプレー" plays={picture} catalog={catalog} level={3} />
      {schemes.map(({ kind, family, plays }) => (
        <PlayList
          heading={`同じ${KIND_LABEL[kind]}スキーム: ${catalog.part({ kind, slug: family }).data.title}`}
          plays={plays}
          catalog={catalog}
          level={3}
        />
      ))}
      <PlayList heading="このプレーを踏まえたプレー" plays={answers} catalog={catalog} level={3} />
    </section>
  )}
</Base>
