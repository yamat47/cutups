---
import Chip from "../../components/Chip.astro";
import Embed from "../../components/Embed.astro";
import Base from "../../layouts/Base.astro";
import { loadCatalog, type Catalog, type Play } from "../../lib/catalog.ts";
import { playHref } from "../../lib/hrefs.ts";
import { gameLabel } from "../../lib/labels.ts";
import { derivedPlays, partsOf } from "../../lib/relations.ts";

export async function getStaticPaths() {
  const catalog = await loadCatalog();
  return catalog.plays.map((play) => ({ params: { slug: play.slug }, props: { play, catalog } }));
}

interface Props {
  play: Play;
  catalog: Catalog;
}

const { play, catalog } = Astro.props;
const { data } = play;
const buildsOn = data.builds_on ? catalog.play(data.builds_on) : undefined;
const derived = derivedPlays(catalog.plays, catalog.parts, play);
---

<Base title={data.title}>
  <h1 class="name">{data.title}</h1>
  <p class="meta muted">
    <span>{gameLabel(data.game)}</span>
    <a href={data.video.url}>@{data.video.author}</a>
  </p>

  <Embed url={data.video.url} title={data.title} />

  <div class="rail">
    {partsOf(data).map((ref) => (
      <Chip part={catalog.part(ref)} />
    ))}
  </div>

  {buildsOn && (
    <p class="muted">
      Built on <a href={playHref(buildsOn.slug)}>{buildsOn.data.title}</a>
    </p>
  )}

  {derived.length > 0 && (
    <section>
      <h2>Derived from this play</h2>
      <ul>
        {derived.map((other) => (
          <li>
            <a class="name" href={playHref(other.slug)}>
              {other.data.title}
            </a>
            <span class="muted">{gameLabel(other.data.game)}</span>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>

<style>
  h1 {
    margin: var(--space-4) 0 0;
    font-size: 2.25rem;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-3);
    margin: var(--space-1) 0 var(--space-3);
  }
  .rail {
    margin-top: var(--space-3);
  }
  section {
    margin-top: var(--space-5);
  }
  h2 {
    margin: 0 0 var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-border);
  }
  li {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 3.5rem;
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--color-border);
  }
  li .name {
    font-size: 1.25rem;
    text-decoration: none;
  }
</style>
