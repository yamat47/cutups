---
import Chip from "../../components/Chip.astro";
import Embed from "../../components/Embed.astro";
import Base from "../../layouts/Base.astro";
import { loadCatalog, type Catalog, type Play } from "../../lib/catalog.ts";
import { playHref } from "../../lib/hrefs.ts";
import { gameLabel } from "../../lib/labels.ts";
import { derivedPlays, partsOf } from "../../lib/relations.ts";

export async function getStaticPaths() {
  const catalog = await loadCatalog();
  return catalog.plays.map((play) => ({ params: { slug: play.slug }, props: { play, catalog } }));
}

interface Props {
  play: Play;
  catalog: Catalog;
}

const { play, catalog } = Astro.props;
const { data } = play;
const buildsOn = data.builds_on ? catalog.play(data.builds_on) : undefined;
const derived = derivedPlays(catalog.plays, catalog.parts, play);
---

<Base title={data.title}>
  <div class="video">
    <Embed url={data.video.url} title={data.title} />
  </div>

  <h1 class="name">{data.title}</h1>
  <p class="meta byline">
    <span>{gameLabel(data.game)}</span>
    <a href={data.video.url}>@{data.video.author}</a>
  </p>

  <div class="rail">
    {partsOf(data).map((ref) => (
      <Chip part={catalog.part(ref)} />
    ))}
  </div>

  {buildsOn && (
    <p class="meta">
      Built on <a href={playHref(buildsOn.slug)}>{buildsOn.data.title}</a>
    </p>
  )}

  {derived.length > 0 && (
    <section>
      <h2>Derived from this play</h2>
      <ul>
        {derived.map((other) => (
          <li>
            <a href={playHref(other.slug)}>
              <span class="name">{other.data.title}</span>
              <span class="meta">{gameLabel(other.data.game)}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>

<style>
  .video {
    margin: 1rem calc(-1 * var(--gutter)) 0;
  }
  .video :global(.frame) {
    border-radius: 0;
  }
  h1 {
    margin: 1rem 0 0;
    font-size: 2.25rem;
  }
  .meta {
    margin: 0.25rem 0 0;
    font-size: 0.8125rem;
    color: var(--color-muted);
  }
  .byline {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.75rem;
  }
  .rail {
    margin-top: 1rem;
  }
  section {
    margin-top: 2.5rem;
  }
  h2 {
    margin: 0 0 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--color-muted);
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li a {
    display: block;
    padding: 0.75rem 0;
    border-top: 1px solid var(--color-border);
    text-decoration: none;
  }
  li .name {
    display: block;
    font-size: 1.25rem;
  }
</style>
