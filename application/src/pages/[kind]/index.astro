---
import { KINDS, type Kind } from "../../content/schema.ts";
import Base from "../../layouts/Base.astro";
import { loadCatalog } from "../../lib/catalog.ts";
import { partHref } from "../../lib/hrefs.ts";
import { KIND_LABEL } from "../../lib/labels.ts";
import { playsWithPart } from "../../lib/relations.ts";

export function getStaticPaths() {
  return KINDS.map((kind) => ({ params: { kind }, props: { kind } }));
}

interface Props {
  kind: Kind;
}

const { kind } = Astro.props;
const catalog = await loadCatalog();
const parts = catalog.parts.filter((part) => part.kind === kind);
---

<Base title={KIND_LABEL[kind]}>
  <h1 class="heading" data-kind={kind}>
    {KIND_LABEL[kind]}
  </h1>
  {parts.length === 0 ? (
    <p>まだありません。</p>
  ) : (
    <ul class="parts" data-kind={kind}>
      {parts.map((part) => (
        <li>
          <a class="name" href={partHref(part)}>
            {part.data.title}
          </a>
          <ul class="meta">
            <li>{part.data.title_ja}</li>
            {part.data.variant_of && (
              <li>{catalog.part({ kind, slug: part.data.variant_of }).data.title} の変種</li>
            )}
            <li>{playsWithPart(catalog.plays, part).length} プレー</li>
          </ul>
        </li>
      ))}
    </ul>
  )}
</Base>

<style>
  .heading {
    margin: var(--space-4) 0 var(--space-2);
    padding-left: var(--space-2);
    border-left: 4px solid var(--kind);
    font-size: var(--text-lg);
  }
  .parts {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .parts > li {
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--color-border);
  }
  .parts .name {
    display: inline-block;
    font-size: 1.5rem;
    line-height: 1.1;
    color: var(--color-fg);
    text-decoration: none;
  }
</style>
