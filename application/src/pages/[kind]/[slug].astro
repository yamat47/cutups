---
// A tag's page is the feed filtered by it. A part's variants count as the part, so
// Counter lists the GY Counter plays too.
import Chip from "../../components/Chip.astro";
import Filter from "../../components/Filter.astro";
import PlayItem from "../../components/PlayItem.astro";
import Base from "../../layouts/Base.astro";
import { loadCatalog, type Catalog, type Part } from "../../lib/catalog.ts";
import { KIND_LABEL } from "../../lib/labels.ts";
import { playsWithPart, variantsOf } from "../../lib/relations.ts";

export async function getStaticPaths() {
  const catalog = await loadCatalog();
  return catalog.parts.map((part) => ({
    params: { kind: part.kind, slug: part.slug },
    props: { part, catalog },
  }));
}

interface Props {
  part: Part;
  catalog: Catalog;
}

const { part, catalog } = Astro.props;
const { kind, data } = part;

const parent = data.variant_of ? catalog.part({ kind, slug: data.variant_of }) : null;
const variants = variantsOf(catalog.parts, part);
const family = new Set(
  [part, ...variants].flatMap((member) => playsWithPart(catalog.plays, member)),
);
const plays = catalog.plays.filter((play) => family.has(play));
---

<Base title={data.title}>
  <Filter catalog={catalog} current={part} />

  <section class="tag" data-kind={kind}>
    <p class="kind">{KIND_LABEL[kind]}</p>
    <h1 class="name">{data.title}</h1>
    {data.aliases.length > 0 && <p class="muted">Also called {data.aliases.join(", ")}</p>}
    {(parent || variants.length > 0) && (
      <div class="rail">
        {parent && <Chip part={parent} />}
        {variants.map((variant) => (
          <Chip part={variant} />
        ))}
      </div>
    )}
    <p class="muted">{plays.length === 1 ? "1 play" : `${plays.length} plays`}</p>
  </section>

  {plays.map((play) => (
    <PlayItem play={play} catalog={catalog} current={part} />
  ))}
</Base>

<style>
  .tag {
    padding: var(--space-4) 0 var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }
  .kind {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--kind);
  }
  h1 {
    margin: 0;
    font-size: 2.25rem;
  }
  .tag .muted {
    margin: var(--space-1) 0 0;
  }
  .rail {
    margin-top: var(--space-3);
  }
</style>
