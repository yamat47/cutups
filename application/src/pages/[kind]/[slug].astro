---
// A tag's page: every play with the part or one of its variants, two to a row.
import Chip from "../../components/Chip.astro";
import PlayCard from "../../components/PlayCard.astro";
import Base from "../../layouts/Base.astro";
import { loadCatalog, type Catalog, type Part } from "../../lib/catalog.ts";
import { KIND_LABEL } from "../../lib/labels.ts";
import { playsWithFamily, variantsOf } from "../../lib/relations.ts";

export async function getStaticPaths() {
  const catalog = await loadCatalog();
  return catalog.parts.map((part) => ({
    params: { kind: part.kind, slug: part.slug },
    props: { part, catalog },
  }));
}

interface Props {
  part: Part;
  catalog: Catalog;
}

const { part, catalog } = Astro.props;
const { kind, data } = part;

const parent = data.variant_of ? catalog.part({ kind, slug: data.variant_of }) : null;
const variants = variantsOf(catalog.parts, part);
const plays = playsWithFamily(catalog.plays, catalog.parts, part);
---

<Base title={data.title}>
  <section class="tag" data-kind={kind}>
    <p class="kind">{KIND_LABEL[kind]}</p>
    <h1 class="name">{data.title}</h1>
    <p class="meta">{plays.length === 1 ? "1 play" : `${plays.length} plays`}</p>
    {data.aliases.length > 0 && <p class="meta">Also called {data.aliases.join(", ")}</p>}
    {(parent || variants.length > 0) && (
      <div class="rail">
        {parent && <Chip part={parent} />}
        {variants.map((variant) => (
          <Chip part={variant} />
        ))}
      </div>
    )}
  </section>

  <div class="grid">
    {plays.map((play) => (
      <PlayCard play={play} />
    ))}
  </div>
</Base>

<style>
  .tag {
    padding-top: 1.5rem;
  }
  .kind {
    margin: 0;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--kind);
  }
  h1 {
    margin: 0;
    font-size: 2.5rem;
  }
  .meta {
    margin: 0.25rem 0 0;
    font-size: 0.8125rem;
    color: var(--color-muted);
  }
  .rail {
    margin-top: 0.75rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 0.75rem;
    margin-top: 1.5rem;
  }
</style>
