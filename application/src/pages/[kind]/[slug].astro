---
import { render } from "astro:content";
import Chip from "../../components/Chip.astro";
import PlayList from "../../components/PlayList.astro";
import Base from "../../layouts/Base.astro";
import { loadCatalog, type Catalog, type Part } from "../../lib/catalog.ts";
import { kindHref } from "../../lib/hrefs.ts";
import { KIND_LABEL, playsWithPartHeading } from "../../lib/labels.ts";
import { playsWithPart, variantsOf } from "../../lib/relations.ts";

export async function getStaticPaths() {
  const catalog = await loadCatalog();
  return catalog.parts.map((part) => ({
    params: { kind: part.kind, slug: part.slug },
    props: { part, catalog },
  }));
}

interface Props {
  part: Part;
  catalog: Catalog;
}

const { part, catalog } = Astro.props;
const { kind, data } = part;
const { Content } = await render(part.entry);

const parent = data.variant_of ? catalog.part({ kind, slug: data.variant_of }) : null;
const variants = variantsOf(catalog.parts, part);
const plays = playsWithPart(catalog.plays, part);
const variantPlays = variants.map((variant) => ({
  variant,
  plays: playsWithPart(catalog.plays, variant),
}));
// "None yet" only when no play in the whole family has the part.
const familyIsEmpty = plays.length === 0 && variantPlays.every(({ plays }) => plays.length === 0);
---

<Base title={data.title}>
  <p class="muted">
    <a href={kindHref(kind)}>{KIND_LABEL[kind]}</a>
  </p>
  <h1>{data.title}</h1>
  <p class="muted">
    {data.title_ja}
    {data.aliases.length > 0 && ` ・ 別名: ${data.aliases.join("、")}`}
  </p>

  {(parent || variants.length > 0) && (
    <dl class="facts">
      {parent && (
        <>
          <dt>変種の元</dt>
          <dd>
            <Chip part={parent} />
          </dd>
        </>
      )}
      {variants.length > 0 && (
        <>
          <dt>変種</dt>
          <dd>
            {variants.map((variant) => (
              <Chip part={variant} />
            ))}
          </dd>
        </>
      )}
    </dl>
  )}

  <div class="body">
    <Content />
  </div>

  <section class="related">
    <PlayList
      heading={playsWithPartHeading(kind)}
      plays={plays}
      catalog={catalog}
      level={2}
      empty={familyIsEmpty ? "まだありません。" : undefined}
    />
    {variantPlays.map(({ variant, plays }) => (
      <PlayList
        heading={`変種 ${variant.data.title} のプレー`}
        plays={plays}
        catalog={catalog}
        level={2}
      />
    ))}
  </section>
</Base>

<style>
  .muted,
  h1 {
    margin: 0;
  }
  h1 + .muted {
    margin-bottom: var(--space-3);
  }
</style>
