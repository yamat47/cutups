---
import PlayCard from "../components/PlayCard.astro";
import Base from "../layouts/Base.astro";
import { loadCatalog } from "../lib/catalog.ts";

const catalog = await loadCatalog();
---

<Base>
  <h1>プレー</h1>
  <p class="muted">
    試合の 1
    プレーを、フォーメーション・モーション・スキーム・アクションの組み合わせとして並べています。チップから同じパーツを使うプレーへ移れます。
  </p>
  {catalog.plays.map((play) => (
    <PlayCard play={play} catalog={catalog} />
  ))}
</Base>
