---
import "../styles/global.css";
import { KINDS } from "../content/schema.ts";
import { kindHref } from "../lib/hrefs.ts";
import { KIND_LABEL } from "../lib/labels.ts";

interface Props {
  /** The page's own name; the site name is added after it. */
  title?: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} | cutups` : "cutups"}</title>
  </head>
  <body>
    <header>
      <a class="site" href="/">
        cutups
      </a>
      <nav>
        <a href="/">プレー</a>
        {KINDS.map((kind) => (
          <a href={kindHref(kind)}>{KIND_LABEL[kind]}</a>
        ))}
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style>
  header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-3);
    padding-bottom: var(--space-3);
    margin-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }
  .site {
    font-size: var(--text-lg);
    font-weight: bold;
    color: var(--color-fg);
    text-decoration: none;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    font-size: var(--text-sm);
  }
  nav a {
    color: var(--color-muted);
  }
  main {
    max-width: 48rem;
  }
</style>
