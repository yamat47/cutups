---
import "../styles/global.css";

interface Props {
  /** The page's own name; the site name is added after it. */
  title?: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f7f9fa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111a21" media="(prefers-color-scheme: dark)" />
    <title>{title ? `${title} | cutups` : "cutups"}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@700&display=swap"
    />
  </head>
  <body>
    <header>
      <a class="name" href="/">
        cutups
      </a>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style>
  header {
    padding-top: max(var(--space-3), env(safe-area-inset-top));
  }
  header a {
    font-size: 1.375rem;
    text-decoration: none;
  }
</style>
